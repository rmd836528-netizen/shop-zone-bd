<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ShopZone BD | Everyday Tech</title><meta name="description" content="Mobile accessories and smart gadgets. Order via WhatsApp.">
<style>
:root{--forest:#174d42;--green:#267b65;--mint:#e9f5ef;--coral:#ff765e;--cream:#fbfaf6;--ink:#172b2a;--muted:#687875;--line:#e3eae5}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Arial,sans-serif}a{text-decoration:none;color:inherit}button,input{font:inherit}.wrap{width:min(1120px,calc(100% - 32px));margin:auto}.announce{background:var(--forest);color:#eaf7ef;text-align:center;padding:9px;font-size:12px}header{position:sticky;top:0;z-index:5;background:var(--cream);border-bottom:1px solid var(--line)}.head{display:flex;align-items:center;gap:18px;padding:15px 0;flex-wrap:wrap}.logo{font-size:24px;font-weight:950;letter-spacing:-1px;white-space:nowrap}.logo b{color:var(--green)}.logo i{font-style:normal;background:var(--coral);color:white;border-radius:10px;padding:4px 8px;margin-right:5px}.search{display:flex;flex:1;min-width:210px;max-width:560px;margin-left:auto;border:1px solid var(--line);background:white;border-radius:12px;overflow:hidden}.search input{border:0;outline:0;padding:13px;flex:1;min-width:0}.search button{border:0;background:var(--green);color:white;padding:0 17px;font-weight:800}.cartbtn{border:1px solid var(--line);background:white;border-radius:11px;padding:11px 13px;font-weight:850;cursor:pointer}.cartbtn span{background:var(--coral);color:white;border-radius:20px;padding:2px 7px}nav{background:white;border-bottom:1px solid var(--line)}.nav{display:flex;gap:25px;padding:13px 0;overflow:auto;white-space:nowrap;font-size:13px;font-weight:800;color:#415752}.nav a:hover{color:var(--coral)}.hero{margin:24px auto 0;background:var(--mint);border-radius:24px;overflow:hidden;display:grid;grid-template-columns:1.1fr .9fr}.hero-copy{padding:clamp(26px,5vw,55px);align-self:center}.eyebrow{display:inline-block;background:white;color:var(--green);border-radius:30px;padding:8px 12px;font-size:10px;letter-spacing:1.3px;font-weight:950;text-transform:uppercase}.hero h1{font-size:clamp(38px,5.5vw,64px);line-height:1;letter-spacing:-2.3px;margin:18px 0}.hero h1 em{font-style:normal;color:var(--green)}.hero p{color:#536a63;line-height:1.8;max-width:470px;font-size:15px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.btn{display:inline-block;padding:13px 17px;border-radius:11px;font-size:13px;font-weight:900}.primary{background:var(--coral);color:white}.secondary{background:white;color:var(--forest);border:1px solid #d5e5dc}.visual{position:relative;display:grid;place-items:center;min-height:330px;background:radial-gradient(circle,#fff 0,#d6eee2 36%,#b6decb 100%)}.orbit{width:270px;aspect-ratio:1;border:1px dashed #6ca28e;border-radius:50%;display:grid;place-items:center}.phone{width:115px;height:200px;border:6px solid #203b37;border-radius:25px;background:linear-gradient(140deg,#ff8c76,#ffd166 50%,#2e9076);box-shadow:0 22px 35px #234c3b30;transform:rotate(-9deg);position:relative}.phone:before{content:"";position:absolute;top:7px;left:50%;transform:translateX(-50%);width:42px;height:8px;border-radius:8px;background:#203b37}.float{position:absolute;width:62px;height:62px;background:white;border-radius:17px;display:grid;place-items:center;font-size:30px;box-shadow:0 12px 28px #234c3b20}.f1{top:15%;left:9%}.f2{top:20%;right:9%}.f3{bottom:12%;left:17%}.sticker{position:absolute;right:7%;bottom:14%;background:var(--coral);color:white;padding:11px 13px;border-radius:12px;font-size:11px;font-weight:950;transform:rotate(-5deg)}.trust{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:17px 0 36px}.trust article{background:white;border:1px solid var(--line);border-radius:15px;padding:15px;display:flex;gap:11px;align-items:center}.trust .ico{font-size:23px;background:var(--mint);border-radius:12px;padding:9px}.trust strong{font-size:12px;display:block}.trust small{display:block;color:var(--muted);font-size:11px;margin-top:4px}.section{margin:38px 0}.sectionhead{display:flex;justify-content:space-between;gap:12px;align-items:end;margin-bottom:17px}.sectionhead h2{font-size:clamp(23px,3vw,31px);letter-spacing:-1px;margin:0}.sectionhead p{font-size:13px;color:var(--muted);margin:7px 0 0}.more{font-size:12px;color:var(--green);font-weight:900;white-space:nowrap}.categories{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.cat{background:white;border:1px solid var(--line);border-radius:16px;padding:18px 8px;text-align:center;transition:.2s}.cat:hover{transform:translateY(-3px);border-color:#a8d5c0}.cat span{display:grid;place-items:center;margin:auto;width:57px;height:57px;border-radius:17px;background:#f4f6ed;font-size:29px}.cat strong{display:block;margin-top:10px;font-size:11px}.filters{display:flex;gap:8px;overflow:auto;margin:0 0 16px}.filter{white-space:nowrap;border:1px solid var(--line);background:white;color:#52635e;padding:9px 13px;border-radius:30px;font-size:11px;font-weight:850;cursor:pointer}.filter.active,.filter:hover{background:var(--forest);color:white;border-color:var(--forest)}.products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.product{background:white;border:1px solid var(--line);border-radius:17px;overflow:hidden;display:flex;flex-direction:column;transition:.2s}.product:hover{transform:translateY(-4px);box-shadow:0 13px 28px #172b2a12}.art{height:155px;background:linear-gradient(135deg,#f3f7f1,#e8f1eb);display:grid;place-items:center;font-size:59px;position:relative}.tag{position:absolute;top:11px;left:11px;background:white;color:var(--green);padding:5px 8px;border-radius:20px;font-size:9px;font-weight:950}.pbody{padding:13px;display:flex;flex-direction:column;flex:1}.label{font-size:9px;color:#8a9892;text-transform:uppercase;letter-spacing:1px;font-weight:900}.product h3{font-size:13px;line-height:1.4;margin:7px 0}.desc{font-size:11px;color:var(--muted);line-height:1.55;min-height:33px}.price{font-size:19px;font-weight:950;color:var(--forest);margin:11px 0}.old{font-size:11px;color:#9aa49f;text-decoration:line-through;margin-left:6px}.add{width:100%;border:0;background:var(--forest);color:white;border-radius:9px;padding:10px;font-size:11px;font-weight:900;cursor:pointer}.buy{display:block;text-align:center;margin-top:7px;padding:9px;border:1px solid #cfe4d8;background:#f6fbf7;color:var(--green);border-radius:9px;font-size:10px;font-weight:900}.promo{margin:40px 0;background:var(--forest);color:white;border-radius:20px;padding:27px;display:flex;justify-content:space-between;align-items:center;gap:15px}.promo h2{margin:0;font-size:27px}.promo p{color:#cce1d7;font-size:13px;line-height:1.7}.promo button{border:0;border-radius:10px;background:#ffd166;padding:13px 16px;font-weight:900;white-space:nowrap;cursor:pointer}.notice{background:#fff8e7;border:1px solid #f4dfaa;color:#735a21;border-radius:11px;padding:12px;font-size:11px;line-height:1.7;margin-top:18px}footer{background:#102d28;color:#eff9f2;padding:33px 0 20px;margin-top:40px}.foot{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:25px}.foot p{color:#b5cdc2;font-size:12px;line-height:1.8}.foot h3{font-size:13px}.footlinks{display:grid;gap:10px;color:#cce1d7;font-size:12px}.copyright{border-top:1px solid #ffffff20;margin-top:22px;padding-top:15px;color:#9ebbb0;font-size:11px}.panel{display:none;position:fixed;inset:0;background:#0a201db0;z-index:20;justify-content:flex-end}.panel.open{display:flex}.drawer{width:min(420px,100%);height:100%;background:white;padding:20px;overflow:auto}.drawerhead{display:flex;justify-content:space-between;align-items:center}.drawerhead h2{margin:0}.close{border:0;background:#edf4ef;border-radius:8px;padding:9px;cursor:pointer}.lineitem{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding:13px 0;font-size:12px}.qty{display:flex;gap:8px;align-items:center;margin-top:8px}.qty button{border:1px solid var(--line);background:white;border-radius:6px;padding:2px 8px}.total{display:flex;justify-content:space-between;font-weight:950;font-size:18px;padding:15px 0}.checkout{width:100%;border:0;border-radius:10px;background:#168447;color:white;padding:14px;font-weight:950;cursor:pointer}
@media(max-width:850px){.products{grid-template-columns:repeat(3,minmax(0,1fr))}.categories{grid-template-columns:repeat(5,minmax(0,1fr))}}
@media(max-width:650px){.wrap{width:calc(100% - 26px)}.head{gap:10px;padding:12px 0}.logo{font-size:21px}.search{order:3;min-width:100%;max-width:none}.hero{grid-template-columns:1fr;margin-top:15px}.hero-copy{padding:27px 21px 20px}.hero h1{font-size:42px}.hero p{font-size:13px}.visual{min-height:230px}.orbit{width:205px}.phone{width:93px;height:165px}.float{width:50px;height:50px;font-size:25px}.trust{grid-template-columns:1fr;gap:8px;margin-bottom:28px}.trust article{padding:11px}.categories{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.cat{padding:12px 4px}.cat span{width:46px;height:46px;font-size:24px}.cat strong{font-size:10px}.products{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.art{height:116px;font-size:47px}.pbody{padding:10px}.product h3{font-size:12px}.desc{font-size:10px}.price{font-size:16px}.promo{align-items:flex-start;flex-direction:column;padding:22px}.foot{grid-template-columns:1fr 1fr}.foot>div:first-child{grid-column:1/-1}.section{margin:29px 0}}
@media(max-width:350px){.hero h1{font-size:36px}.categories{grid-template-columns:repeat(2,1fr)}}
</style></head><body>
<div class="announce">✨ Handy gadgets, everyday value · Order directly on WhatsApp</div>
<header><div class="wrap head"><a class="logo" href="#"><i>S</i>ShopZone <b>BD</b></a><form class="search" id="searchForm"><input id="searchInput" placeholder="Search chargers, earbuds, cables…" aria-label="Search products"><button>Search ↗</button></form><button class="cartbtn" id="openCart">🛍️ Cart <span id="count">0</span></button></div></header>
<nav><div class="wrap nav"><a href="#">Home</a><a href="#categories">Categories</a><a href="#products">All Products</a><a href="#offers">Offers</a><a href="#contact">Contact</a></div></nav>
<main class="wrap">
<section class="hero"><div class="hero-copy"><span class="eyebrow">Your everyday tech shop</span><h1>Little upgrades.<br><em>Better everyday.</em></h1><p>Discover handy mobile accessories and smart gadgets selected for everyday life. Browse the collection and order easily through WhatsApp.</p><div class="actions"><a class="btn primary" href="#products">Explore products ↗</a><a class="btn secondary" href="#categories">Browse categories</a></div></div><div class="visual"><div class="orbit"><div class="phone"></div></div><div class="float f1">🎧</div><div class="float f2">🔌</div><div class="float f3">⌚</div><div class="sticker">SMART PICKS ✦</div></div></section>
<section class="trust"><article><div class="ico">💬</div><div><strong>Easy WhatsApp ordering</strong><small>Ask questions before you buy</small></div></article><article><div class="ico">🔎</div><div><strong>Find your next gadget</strong><small>Search the collection quickly</small></div></article><article><div class="ico">🧡</div><div><strong>Friendly local service</strong><small>Simple direct communication</small></div></article></section>
<section class="section" id="categories"><div class="sectionhead"><div><h2>Shop by category</h2><p>Find the little things that make tech easier.</p></div><a class="more" href="#products">See all →</a></div><div class="categories"><a class="cat" href="#products" data-cat="Mobile Accessories"><span>📱</span><strong>Mobile Accessories</strong></a><a class="cat" href="#products" data-cat="Audio"><span>🎧</span><strong>Audio & Earbuds</strong></a><a class="cat" href="#products" data-cat="Charging"><span>🔌</span><strong>Charging</strong></a><a class="cat" href="#products" data-cat="Smart Gadgets"><span>⌚</span><strong>Smart Gadgets</strong></a><a class="cat" href="#products" data-cat="Everyday Tech"><span>💡</span><strong>Everyday Tech</strong></a></div></section>
<section class="section" id="products"><div class="sectionhead"><div><h2>Popular picks</h2><p>Demo products and prices — update these to match your real stock.</p></div></div><div class="filters"><button class="filter active" data-filter="All">All items</button><button class="filter" data-filter="Mobile Accessories">Accessories</button><button class="filter" data-filter="Audio">Audio</button><button class="filter" data-filter="Charging">Charging</button><button class="filter" data-filter="Smart Gadgets">Smart gadgets</button></div><div class="products" id="grid"></div><div class="notice">📌 <b>Store note:</b> Product names, prices and availability are demo examples. Confirm stock, delivery charges and payment details with the seller before paying.</div></section>
<section class="promo" id="offers"><div><h2>Found something you like?</h2><p>Add items to your cart and send the full order to ShopZone BD through WhatsApp.</p></div><button id="promoCart">View my cart →</button></section>
</main><footer id="contact"><div class="wrap"><div class="foot"><div><a class="logo" style="color:white" href="#"><i>S</i>ShopZone <b>BD</b></a><p>Mobile accessories and useful gadgets, all in one simple online shop. Message us to ask about products and delivery.</p></div><div><h3>Explore</h3><div class="footlinks"><a href="#categories">Categories</a><a href="#products">Popular picks</a><a href="#offers">Special offers</a></div></div><div><h3>Contact</h3><div class="footlinks"><a id="waContact" href="#" target="_blank" rel="noopener">WhatsApp: 01878470827</a><span>Bangladesh</span></div></div></div><div class="copyright">© <span id="year"></span> ShopZone BD · Made for everyday smart shopping.</div></div></footer>
<div class="panel" id="panel"><div class="drawer"><div class="drawerhead"><h2>Your cart</h2><button class="close" id="close">✕ Close</button></div><div id="items"></div><div class="total"><span>Total</span><span id="total">৳0</span></div><button class="checkout" id="checkout">Order on WhatsApp ↗</button><p style="font-size:11px;color:#687875;line-height:1.7">Confirm availability and delivery details in WhatsApp.</p></div></div>
<script>
const WA="8801878470827";
const products=[
{id:1,name:"Fast USB-C Charger",cat:"Charging",price:650,old:800,icon:"🔌",tag:"POPULAR",desc:"Compact charger for everyday top-ups."},
{id:2,name:"Wireless Earbuds",cat:"Audio",price:1250,old:1500,icon:"🎧",tag:"BEST SELLER",desc:"Convenient audio for music and calls."},
{id:3,name:"Protective Phone Case",cat:"Mobile Accessories",price:250,old:350,icon:"📱",tag:"VALUE PICK",desc:"Everyday protection for your phone."},
{id:4,name:"Power Bank 10000mAh",cat:"Charging",price:1450,old:1700,icon:"🔋",tag:"TRAVEL PICK",desc:"Extra power when you are away from home."},
{id:5,name:"Smart Watch",cat:"Smart Gadgets",price:1850,old:2200,icon:"⌚",tag:"TRENDING",desc:"A handy wearable for daily routines."},
{id:6,name:"Bluetooth Speaker",cat:"Audio",price:990,old:1200,icon:"🔊",tag:"POPULAR",desc:"Portable sound for your favourite moments."},
{id:7,name:"USB-C Cable",cat:"Mobile Accessories",price:180,old:250,icon:"〰️",tag:"ESSENTIAL",desc:"A practical cable for charging and syncing."},
{id:8,name:"Mini Desk Fan",cat:"Everyday Tech",price:550,old:700,icon:"🪭",tag:"SUMMER PICK",desc:"Small fan for your desk or study space."}
];let cart=[],filter="All",query="";
const money=n=>"৳"+Number(n).toLocaleString("en-BD");
const wa=msg=>"https://wa.me/"+WA+"?text="+encodeURIComponent(msg);
function render(){let list=products.filter(p=>(filter==="All"||p.cat===filter)&&(`${p.name} ${p.cat} ${p.desc}`).toLowerCase().includes(query.toLowerCase()));document.getElementById("grid").innerHTML=list.length?list.map(p=>`<article class="product"><div class="art"><span class="tag">${p.tag}</span>${p.icon}</div><div class="pbody"><span class="label">${p.cat}</span><h3>${p.name}</h3><div class="desc">${p.desc}</div><div class="price">${money(p.price)} <span class="old">${money(p.old)}</span></div><button class="add" onclick="add(${p.id})">＋ Add to cart</button><a class="buy" href="${wa('Hello ShopZone BD! I am interested in '+p.name+'. Please confirm availability and delivery details.')}" target="_blank" rel="noopener">Ask / order on WhatsApp</a></div></article>`).join(""):"<p>No products found. Try another search.</p>"}
function add(id){let x=cart.find(i=>i.id===id);x?x.qty++:cart.push({id,qty:1});renderCart()}
function qty(id,d){let x=cart.find(i=>i.id===id);if(!x)return;x.qty+=d;if(x.qty<1)cart=cart.filter(i=>i.id!==id);renderCart()}
function renderCart(){document.getElementById("count").textContent=cart.reduce((s,x)=>s+x.qty,0);document.getElementById("items").innerHTML=cart.length?cart.map(x=>{let p=products.find(p=>p.id===x.id);return `<div class="lineitem"><div><b>${p.name}</b><div style="margin-top:5px;color:#687875">${money(p.price)} each</div><div class="qty"><button onclick="qty(${p.id},-1)">−</button>${x.qty}<button onclick="qty(${p.id},1)">＋</button></div></div><b>${money(p.price*x.qty)}</b></div>`}).join(""):'<p style="color:#687875">Your cart is empty. Add a product to get started.</p>';document.getElementById("total").textContent=money(cart.reduce((s,x)=>s+products.find(p=>p.id===x.id).price*x.qty,0))}
function openCart(){document.getElementById("panel").classList.add("open")}
document.getElementById("openCart").onclick=openCart;document.getElementById("promoCart").onclick=openCart;document.getElementById("close").onclick=()=>document.getElementById("panel").classList.remove("open");document.getElementById("panel").onclick=e=>{if(e.target.id==="panel")e.currentTarget.classList.remove("open")};
document.getElementById("checkout").onclick=()=>{if(!cart.length){alert("Your cart is empty. Add a product first.");return}let lines=cart.map(x=>{let p=products.find(p=>p.id===x.id);return `${p.name} x ${x.qty} = ${money(p.price*x.qty)}`});let total=cart.reduce((s,x)=>s+products.find(p=>p.id===x.id).price*x.qty,0);window.open(wa("Hello ShopZone BD! I would like to order:\n"+lines.join("\n")+"\nTotal: "+money(total)+"\nPlease confirm availability, delivery charge and payment options."),"_blank","noopener")};
document.getElementById("searchForm").onsubmit=e=>{e.preventDefault();query=document.getElementById("searchInput").value.trim();filter="All";document.querySelectorAll(".filter").forEach(b=>b.classList.toggle("active",b.dataset.filter==="All"));render();document.getElementById("products").scrollIntoView({behavior:"smooth"})};
document.querySelectorAll(".filter").forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll(".filter").forEach(x=>x.classList.toggle("active",x===b));render()});
document.querySelectorAll("[data-cat]").forEach(a=>a.onclick=()=>{filter=a.dataset.cat;document.querySelectorAll(".filter").forEach(x=>x.classList.toggle("active",x.dataset.filter===filter));render()});
document.getElementById("waContact").href=wa("Hello ShopZone BD! I have a question about your products.");document.getElementById("year").textContent=new Date().getFullYear();render();renderCart();
</script></body></html>